{
  "manifest_version": 3,
  "name": "Foldex Capture",
  "version": "2.18.0",
  "description": "Save the current tab to your Foldex bookmark manager.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Foldex"
  },
  "options_page": "options.html"
}
