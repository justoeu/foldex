# Foldex environment configuration
# `make env` copies this file to .env and fills security-sensitive blanks once.
# Edit the resulting local file as needed; it is gitignored and mode 0600.

# ---- Image tag pulled from Docker Hub ----
# `make up` uses justoeu/foldex-{backend,web}:${FOLDEX_VERSION}. Common values:
#   latest         → newest build from main
#   sha-<7chars>   → pin to a specific commit
#   1.2.3          → pin to a release (NO leading `v` — the git tag is v1.2.3
#                    but docker/metadata-action strips the `v` from image tags)
# Leave unset to default to `latest`. Use `make up-build` to ignore this and
# build from local source instead.
FOLDEX_VERSION=latest

# ---- Postgres (single source of truth) ----
POSTGRES_USER=foldex
POSTGRES_PASSWORD=foldex
POSTGRES_DB=foldex
POSTGRES_PORT=5432
# Hostname seen by the backend container:
#  - `db`                    → self-hosted via docker-compose.db.yml (default)
#  - `localhost` / `host.docker.internal` → reuse a Postgres on your host
#  - any reachable hostname  → external DB (RDS, etc.)
POSTGRES_HOST=db

# Postgres SSL mode used by the backend driver. Valid values (see PG docs):
#   disable | allow | prefer | require | verify-ca | verify-full
# Default is `disable` for local dev. Use `require` (or stricter) for any
# Postgres reachable over the public internet.
POSTGRES_SSLMODE=disable

# DB_URL is DERIVED from the POSTGRES_* vars above (see docker-compose.yml
# and backend/Makefile). Override DB_URL only if you need a fully custom DSN
# that the variables above can't express.
#DB_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# ---- Backend ----
BACKEND_PORT=9089

# Bearer token protecting GET /metrics (Prometheus scrape by the central
# observability stack — app-deployments/observability). Empty = endpoint
# disabled (answers 503). Generate with: openssl rand -hex 32
# The SAME value goes into the stack's FOLDEX_TOKEN env on the Coolify side.
METRICS_TOKEN=

# OTLP/gRPC endpoint for distributed traces — the Tempo of the central
# observability stack (e.g. http://obs-host:4317; `https://` switches to TLS,
# a trailing path is stripped). Empty = tracing fully off: no provider, no
# exporter, no per-request spans.
#
# With it set, every AUTHENTICATED request span carries `user.id` (the opaque
# account id, TraceQL `span.user.id`), `user.roles` and `foldex.auth.via`. No
# address and no display name — a trace store is a different retention domain
# from the database. Keep `user.id` OFF Tempo's span-metrics dimensions: it is
# one time series per account.
#
# `http://` (and a bare host:port) means PLAINTEXT, UNAUTHENTICATED gRPC. That
# identity crosses the wire in the clear on every request, so use `https://`
# for any collector not on this host or a network you fully control. Trace-store
# read access is effectively an administrative privilege of this instance: it
# enumerates which accounts are administrators and profiles their activity.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Inside-container listen address. Default empty → backend's own default of
# 127.0.0.1 applies (correct for bare-host deploys per CLAUDE.md §0).
# Docker Compose overrides this to 0.0.0.0 automatically so nginx in the
# sibling container can reach the backend; the host-side port mapping
# remains loopback-only via BIND_HOST.
BACKEND_BIND=

# Worker concurrency for URL preview fetcher (clamped to 1..8).
PREVIEW_WORKER_CONCURRENCY=4
PREVIEW_FETCH_TIMEOUT_SEC=5

# When set to `1`/`true`, preview fetches refuse the complete IANA
# special-purpose registries (loopback, RFC1918, link-local, benchmarking,
# documentation/reserved space and IPv6 ULA). Default permits ordinary
# intranet links (Jira, Grid, Confluence, internal dashboards). Cloud
# metadata/credential endpoints and RFC6598 are always blocked.
PREVIEW_STRICT_SSRF=

# CORS origins allowed by the backend (comma-separated). Defaults to the
# bundled HTTPS web origin. Do NOT use `*` here with the Compose deployment:
# CORS only constrains browsers, and the deployment is reachable beyond
# yours. Set a concrete origin before loosening this.
CORS_ORIGINS=https://localhost

# ---- Multi-user authentication (ADR-30) ----
# ON by default since 1.13.0.
#
# On an existing install the first visit lands on the setup screen. Completing
# it CLAIMS the bootstrap administrator row — the one migration 000017 adopted
# every pre-existing link, note, folder and tag into — so your library is intact
# behind your new account. Nothing is lost and nothing has to be re-imported.
#
# Setting it to 0 keeps the old single-user behaviour: every request is
# attributed to the bootstrap administrator and nothing ever asks for a
# password. That is a real escape hatch for a machine on a private network with
# one user, not a deprecated flag — but on that setting anyone who can reach the
# port owns the whole library, so keep the loopback bind.
AUTH_ENABLED=1

# Public origin baked into invitation links. It CANNOT be derived from the
# request: Host and X-Forwarded-Host are attacker-supplied, and a
# credential-bearing link built from them is the classic reset-poisoning
# primitive — the mail reaches the real user but points at the attacker's host.
# NOTE the PORT. The bundled stack serves the SPA on WEB_HTTPS_PORT (9444 by
# default); the plain-HTTP port only 301s to https on 443, where nothing
# listens. Invite links, reset links and the Google redirect URI are all built
# from this value, so a portless origin here sends every one of them somewhere
# that does not answer.
AUTH_PUBLIC_URL=https://localhost:9444

# Session lifetimes. The refresh token slides forward on every rotation;
# AUTH_ABSOLUTE_TTL_DAYS is the ceiling measured from the login itself, without
# which a stolen refresh token that keeps rotating would never expire.
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_ABSOLUTE_TTL_DAYS=90
# Window in which re-presenting an already-used refresh token counts as a
# racing browser tab rather than a replay attack. Setting it to 0 makes any
# double-mount of the SPA sign the user out.
AUTH_REFRESH_GRACE_SEC=10
AUTH_SWEEP_INTERVAL_MIN=60
AUTH_SWEEP_RETAIN_DAYS=7

# Cookie Secure is NOT set directly — it is derived, because getting it wrong
# fails silently: a browser drops a Secure cookie over plain HTTP without a
# word, so login "succeeds" and the next request is anonymous.
#
# It follows the SCHEME OF AUTH_PUBLIC_URL when you set one, because that is
# the origin the browser actually talks to. Behind a TLS-terminating nginx the
# backend is bound to 127.0.0.1 while the browser is on HTTPS, and deriving
# from the bind alone got that backwards — it shipped session cookies with no
# Secure flag, so any http:// request put them on the wire in cleartext.
# Leave AUTH_PUBLIC_URL unset and it falls back to BACKEND_BIND: loopback means
# plain-HTTP dev, anything else means Secure.
# Set AUTH_COOKIE_DOMAIN only if you need the cookies shared across subdomains
# (host-only, the default, is safer).
AUTH_COOKIE_DOMAIN=

# ---- Trusted reverse proxies ----
# CSV of IPs or CIDRs whose X-Forwarded-For header may be believed. Empty (the
# default) means believe nobody: RemoteAddr is used as-is.
#
# Behind nginx, set this to the proxy's address or the compose subnet, or every
# rate-limit bucket keyed by IP will see the proxy instead of the client and
# throttle all your users as one. On a direct bind, leave it empty — an
# unconditionally-trusted header lets an attacker both evade their own bucket
# and pin the cost on someone else's address.
#
# docker-compose.yml already defaults this to the private ranges Docker
# allocates from, so the shipped stack works without you setting anything. Set
# it here only to narrow that (the exact nginx address) or to widen it.
#
#   TRUSTED_PROXY_IPS=172.18.0.5
#
# Leave it EMPTY for a direct bind with no proxy in front.
TRUSTED_PROXY_IPS=

# ---- Two-step verification (TOTP) ----
# AUTH_ENCRYPTION_KEY encrypts the TOTP seeds at rest (AES-256-GCM, base64,
# 32+ bytes). Seeds cannot be hashed — verifying a code needs the seed itself —
# and a plaintext seed in a pg_dump is a permanent 2FA bypass.
#
# THIS KEY IS NOT REGENERABLE. Unlike FOLDER_UNLOCK_KEY, losing it makes every
# stored seed undecryptable and locks every 2FA user out of their own account,
# recoverable only by an administrator clearing their enrollment. That is why
# the backend REFUSES TO BOOT rather than quietly minting a session-only key:
# starting successfully and only discovering the loss at the next restart would
# destroy every enrollment made in between. Back this file up with your database.
# TWO WAYS TO PROVIDE IT, and the env value always wins:
#
#   (a) leave AUTH_ENCRYPTION_KEY empty and let the backend generate and persist
#       one at AUTH_ENCRYPTION_KEY_PATH on first boot. Zero-config, and the same
#       shape VAPID and FOLDER_UNLOCK_KEY already use.
#
#   (b) set AUTH_ENCRYPTION_KEY here — `openssl rand -base64 32` — and set
#       AUTH_ENCRYPTION_AUTO_GENERATE=0. One file holds every secret, and it is
#       the only option when /data is not writable (a bare-host `make run`).
#
# If you pick (b), turning auto-generation OFF is not optional: with it on,
# accidentally dropping the line below lets the backend mint a FRESH key and
# boot normally, silently orphaning every enrolled authenticator. Off, the same
# mistake is a boot failure naming the missing variable.
#
# Trade-off worth knowing for (b): anything in the process environment is
# readable via `docker inspect`, /proc/<pid>/environ and by child processes,
# where a file read once at boot is not. Whichever you choose, chmod 600 it.
AUTH_ENCRYPTION_KEY=
AUTH_ENCRYPTION_KEY_PATH=/data/auth_encryption.key
AUTH_ENCRYPTION_AUTO_GENERATE=1

# The label authenticator apps display next to the code. Defaults to
# "Foldex (<host of AUTH_PUBLIC_URL>)" so two instances are tellable apart.
AUTH_TOTP_ISSUER=

# Administrators can invite, promote and delete accounts, so a stolen admin
# password should not be one factor away from the whole instance. With this on,
# an admin without an authenticator is diverted into mandatory enrollment at
# login rather than refused (which would lock out every existing admin the
# moment the flag flips).
AUTH_REQUIRE_2FA_FOR_ADMINS=1

# ---- Google sign-in (ADR-31) ----
# Both values are required together; with either empty the provider reports
# itself disabled, the SPA hides the button, and the routes answer a readable
# "not configured" rather than 404.
#
# Create an OAuth client of type "Web application" in the Google Cloud console
# and register this EXACT redirect URI:
#
#     <AUTH_PUBLIC_URL>/api/auth/oauth/google/callback
#
# Google compares it byte for byte — a trailing slash or an http/https mismatch
# produces a redirect_uri_mismatch that says nothing about which side is wrong.
# The URI is derived from AUTH_PUBLIC_URL and is deliberately NOT configurable:
# an operator-settable redirect is an open redirect on a route that issues
# session cookies. The backend logs the exact string at boot when enabled.
#
# Two things Google sign-in deliberately does NOT do. It never creates an
# account — the instance is invite-only, and auto-provisioning would be a silent
# bypass of that. And it never skips the second factor: signing in with Google
# lands on the same code screen a password login does.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Legacy numeric share links (ADR-32) ----
# /go/{id} and /n/{id} resolve with NO session — they are public share links, so
# there is no tenant to scope the lookup by. Link ids are a dense counter now
# shared across every account, so leaving numeric lookup on lets anyone walk
# 1, 2, 3... and enumerate (and click-log) every link and note on the instance,
# including other people's. Slugs are not secret either, but they are not a
# counter: you cannot find the next one by adding 1.
#
# Turn this on ONLY if you have old /go/42 links already shared somewhere and
# would rather keep them working. Newly created links always get a slug.
PUBLIC_NUMERIC_IDS=0

# ---- Transactional e-mail (invitations, password reset, sign-in codes) ----
# `log` (the default) writes the message — invite link included — to the
# backend log instead of sending it. That is deliberate for a self-hosted
# product: an operator who never configures SMTP must still be able to complete
# an invitation by reading `docker compose logs backend`. The admin screen also
# shows the link once, when the invite is created.
#
# Set MAIL_DRIVER=smtp for real delivery. `make up-mail` starts Mailpit and
# gives you a local inbox at http://localhost:8025.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=foldex@localhost
MAIL_FROM_NAME=Foldex
MAIL_STARTTLS=1
MAIL_TLS=0
# Only for a self-signed LOCAL test server. Pointed at a real host it turns TLS
# into obfuscation, so the backend refuses to boot with it set alongside a
# non-loopback MAIL_HOST.
MAIL_INSECURE_SKIP_VERIFY=0

# ---- Mail transport (ADR-36) ----
# Every message is written to a transactional outbox, in the SAME transaction as
# the credential it carries. What changes here is only the SINK the relay
# delivers through — nothing above it moves.
#
#   inproc (default)  the backend renders and sends in-process. One binary and a
#                     Postgres are enough: durability, retry and backoff all
#                     still apply; only horizontal scale is lost.
#   amqp              publishes to the broker; the `cmd/mailer` worker consumes,
#                     decrypts and sends. Requires AMQP_URL.
#
# An UNKNOWN value refuses to boot instead of falling back to inproc: a silent
# downgrade keeps mail working, so nothing looks broken, while every message an
# operator expects on the broker is sent by the backend they just scaled workers
# away from.
MAIL_TRANSPORT=inproc

# Which compose profiles start. This exists directly above MAIL_TRANSPORT
# because the two must agree and there is no mechanism that makes them: the
# `mailer` service carries `profiles: ["amqp"]`, so a plain `docker compose up
# -d` on an instance set to MAIL_TRANSPORT=amqp brings up a backend that
# publishes and NO worker that consumes. Nothing else in the system catches
# that: the publish is routable and confirmed, the outbox row settles as
# `published`, and the queue quietly fills. The backend logs a warning when it
# publishes into a queue with no consumer, which is the only signal before a
# user reports the e-mail never arrived — setting this correctly is what keeps
# the situation from arising at all.
#
# Set it to `amqp` in the same edit that sets MAIL_TRANSPORT=amqp. Leave it
# empty for inproc: the worker has nothing to consume there, and it would
# refuse to boot anyway without an AMQP_URL.
COMPOSE_PROFILES=

# ---- Operational backup agent (ADR-43, docs/SDD-OPS-BACKUP.md) ----
# Scheduled pg_dump of the WHOLE database (auth included), encrypted with age
# and shipped to an external S3-compatible bucket. Off by default: add
# `backup` to COMPOSE_PROFILES in the SAME edit that fills the block below —
# a filled block with no profile runs nothing, and a profile with an empty
# block refuses to boot (fail-fast beats a silent non-backup).
# The backend NEVER receives these credentials; only the backup service does.

# Where the backups go. Any S3-compatible target works (AWS S3, MinIO, R2,
# another RustFS). Region matters on real AWS outside us-east-1.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_USE_SSL=true

# Daily wall-clock anchor, HH:MM in TZ (weekly anchors take "HH:MM sun").
# This is an instant, not a duration — the one deviation from the *_SEC/_MIN
# convention, on purpose.
BACKUP_DUMP_AT=03:30

# age public keys (comma-separated) that can DECRYPT the dumps. Generate a
# pair with `age-keygen`; keep the private identity in a vault OFF this host —
# a key that lives next to the data is a backup you cannot open when the host
# dies. Encryption is default-mandatory: with this empty the agent refuses to
# boot unless BACKUP_ALLOW_PLAINTEXT=1 (for buckets that encrypt server-side).
BACKUP_AGE_RECIPIENTS=
BACKUP_ALLOW_PLAINTEXT=0

# Retention (GFS): keep N daily, N weekly (Sundays), N monthly (1st) dumps.
# BACKUP_RETENTION_MODE=agent — the agent prunes (needs DeleteObject).
# BACKUP_RETENTION_MODE=bucket — hardened: give the agent a credential WITHOUT
# DeleteObject and let bucket lifecycle/versioning expire old dumps; the
# agent's prune becomes a declared no-op. Agent mode means a compromised host
# can delete history; bucket mode is the ransomware-resistant choice.
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_RETAIN_MONTHLY=6
BACKUP_RETENTION_MODE=agent

# The agent serves /healthz and /metrics (Bearer METRICS_TOKEN — the same
# token the backend's /metrics uses) on this address inside the foldex
# network. See deploy/observability/ for scrape config and alert rules.
BACKUP_METRICS_ADDR=:9099

# Only read when MAIL_TRANSPORT=amqp. User, password and virtual host are all
# COMPONENTS OF THIS URL — there is no AMQP_USER/AMQP_PASSWORD/AMQP_VHOST:
#
#   amqps://user:password@broker.example:5671/my-vhost
#           `--,-` `--,---` `------,-----` `-,-` `--,---`
#            user   password       host       port   vhost
#
# The vhost is the path segment. An empty path, a bare "/" and "%2F" all mean
# the DEFAULT vhost "/" — only a name changes it. URL-encode any character that
# would break the URL (a "/" inside a vhost name becomes %2F).
#
# Plain `amqp://` against a NON-loopback host is REFUSED unless
# AMQP_ALLOW_PLAINTEXT=1 (see below), for the same reason
# MAIL_INSECURE_SKIP_VERIFY is: the credential above would cross the network in
# clear. Use `amqps://` off-box — and see the TLS query parameters below if
# your broker is signed by a private CA, which on an intranet it almost
# certainly is.
AMQP_URL=

# TLS to a private broker is configured IN THE URL, not by a separate variable.
# The AMQP URI spec carries these query parameters and the client honours them:
#
#   ?cacertfile=/path/ca.pem        trust this CA instead of the host root store
#   ?certfile=/path/cert.pem        client certificate (mTLS)
#   ?keyfile=/path/key.pem          its key -- both are required together
#   ?server_name_indication=NAME    SNI, when the certificate names something
#                                   other than the host in the URL
#
# An intranet broker addressed by IP therefore looks like:
#
#   AMQP_URL=amqps://user:pass@10.0.0.5:5671/foldex?cacertfile=/etc/foldex/certs/ca.pem
#
# Without cacertfile the chain is checked against the host root store, which no
# private CA is in -- the failure reads "x509: certificate signed by unknown
# authority" and looks like a broker problem when it is a trust problem.
#
# UNDER DOCKER these paths resolve INSIDE the container. Drop the PEM in ./certs
# on the host; compose mounts it read-only at /etc/foldex/certs for the backend
# and the mailer, so the path above works as written.
#
# A certificate for an IP needs an IP SAN. A DNS name does not match an address,
# and server_name_indication does not paper over that -- it changes which name
# is checked, not whether the address is in the certificate.

# Topology. What travels the wire is the SAME sealed ciphertext the outbox row
# holds — the broker persists to disk and is routinely shared between projects,
# so it never sees a rendered reset link. Only cmd/mailer opens the envelope,
# and it holds no database credential, by construction.
# Permit plaintext amqp:// to a broker that is not loopback. OFF by default.
#
# What crosses the wire in clear when this is on:
#   - the broker credential from AMQP_URL (SASL PLAIN, user and password)
#   - the exchange, queue and routing key
#   - the RECIPIENT's e-mail address and the TEMPLATE name of every message,
#     which together say who is receiving which credential, and when
# What does NOT: the message body. It stays AES-256-GCM under a derived subkey,
# so reset links and sign-in codes are never exposed by this setting.
#
# The flag is a claim about the NETWORK, so it is checked against the network at
# BOTH moments it can be checked:
#   - at boot, when AMQP_URL carries an IP literal
#   - at dial, against the address actually reached -- which is what covers a
#     HOSTNAME (the majority form, a compose service name included), whose
#     resolution the operator may not control and can change at any reconnect
# Either check refuses anything outside RFC1918, CGNAT (100.64/10), loopback and
# link-local. A refused dial is closed before the AMQP handshake writes the
# credential.
AMQP_ALLOW_PLAINTEXT=0

AMQP_EXCHANGE=foldex.mail
AMQP_QUEUE=foldex.mail.send
AMQP_ROUTING_KEY=send

# Prefetch per consumer. SMTP delivery is serial I/O; a high prefetch only
# lengthens redelivery when a worker dies.
AMQP_PREFETCH=4

# Relay: how many pending rows to drain per round, and how often to wake up.
# Both apply to either transport — the relay is what drains the outbox, and it
# runs whether or not a broker is involved.
MAIL_OUTBOX_BATCH=32
MAIL_OUTBOX_POLL_SEC=5

# ---- RustFS (S3-compatible object storage for screenshots / note images) ----
# Two principals:
#  1. ROOT  — only for the rustfs server process + one-shot rustfs-init
#             bootstrap (creates the app user + bucket-scoped policy).
#  2. APP   — what the Foldex backend uses at runtime (least privilege:
#             list/location on RUSTFS_BUCKET plus object get/put/delete and
#             multipart operations; no policy or ACL administration).
#
# Endpoint seen by the backend:
#  - `rustfs:9000` → self-hosted via docker-compose.yml (default)
#  - `localhost:9000` → RustFS on the host (bare `go run` / bun dev)
# Console UI: http://localhost:9001  (login with ROOT credentials)
#
# After `make up`, rustfs-init runs once. For a bare-metal RustFS:
#   go run ./cmd/rustfs-bootstrap   # same job, for bare-metal
RUSTFS_ENDPOINT=rustfs:9000
RUSTFS_USE_SSL=false
RUSTFS_BUCKET=foldex-screenshots
# Root (server + bootstrap only — do NOT give these to the backend)
RUSTFS_ROOT_ACCESS_KEY=rustfsadmin
RUSTFS_ROOT_SECRET_KEY=
# App principal (backend)
# Host-side ports for the bundled object store (docker-compose.services.yml).
# Configurable because 9000/9001 are the S3 defaults every MinIO-shaped service
# on a developer machine also claims. The CONTAINER side is fixed: the backend
# reaches the store as `rustfs:9000` over the compose network.
RUSTFS_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001

RUSTFS_ACCESS_KEY=foldex
RUSTFS_SECRET_KEY=
RUSTFS_APP_POLICY=foldex-app
# `make env` generates and persists both blank secrets above without printing
# them. The shipped placeholders are rejected. This escape hatch exists only
# for an isolated disposable development instance.
RUSTFS_ALLOW_INSECURE_DEV_CREDENTIALS=0

# ---- Change-detection worker (per-link opt-in) ----
# When CHANGECHECK_ENABLED=1 the backend runs a background worker that
# re-fetches each opted-in link (link.check_interval = hourly/daily/weekly)
# and emits a Web Push notification when the page's content fingerprint
# changes. Set to 0 (or empty) to disable the worker entirely.
CHANGECHECK_ENABLED=1
# Fetch worker concurrency (clamped to 1..8).
CHANGECHECK_WORKER_CONCURRENCY=2
CHANGECHECK_SCAN_INTERVAL_SEC=60
CHANGECHECK_FETCH_TIMEOUT_SEC=20

# ---- Web Push / VAPID ----
# Identity keys used by the Web Push protocol (RFC 8030). Leave empty +
# VAPID_AUTO_GENERATE=1 to let the backend generate and persist a keypair
# under VAPID_STATE_PATH on first boot. Pin both keys in .env for stable
# behaviour across container recreations — otherwise every fresh container
# invalidates all browser subscriptions (the public key changes).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:foldex@localhost
VAPID_AUTO_GENERATE=1
VAPID_STATE_PATH=/data/vapid.json

# ---- Folder password protection ----
# HMAC secret for folder-unlock tokens (base64, 32+ bytes). Leave empty +
# FOLDER_UNLOCK_AUTO_GENERATE=1 to let the backend generate and persist one
# under FOLDER_UNLOCK_KEY_PATH on first boot. Pin it in .env for stable
# behaviour across container recreations — otherwise every fresh container
# invalidates all outstanding folder-unlock sessions (harmless: users just
# re-enter the folder password).
FOLDER_UNLOCK_KEY=
FOLDER_UNLOCK_AUTO_GENERATE=1
FOLDER_UNLOCK_KEY_PATH=/data/folder_unlock.key

# ---- Web ----
WEB_PORT=9088
WEB_HTTPS_PORT=9444
# Host:PORT baked into the HTTP→HTTPS redirect (not taken from the request
# Host header). Use your LAN IP/hostname when WEB_BIND_HOST=0.0.0.0.
#
# Include the port unless you serve on 443. nginx redirects to
# https://<this value>, so a bare `localhost` here sends the browser to 443 —
# where this stack has nothing listening, and the redirect dead-ends.
WEB_PUBLIC_HOST=localhost:9444
# Base URL of the backend, as seen from the user's browser.
VITE_API_BASE=http://localhost:9089

# ---- LAN access (phones / iPads on the same wifi) ----
# Default 127.0.0.1 = loopback only — the safe default for the single-user,
# no-public-exposure threat model. Set WEB_BIND_HOST=0.0.0.0 to reach the
# SPA at https://<your-mac-LAN-ip>:9444 from another device on the wifi.
# Re-emit the mkcert pair with the same LAN IP in its SAN list, otherwise
# the phone's browser rejects the cert before nginx even sees the request.
# Backend stays loopback-only by default — nginx proxies /api/ + /go/, so
# the backend doesn't need a second open port on the LAN.
WEB_BIND_HOST=127.0.0.1
BIND_HOST=127.0.0.1
