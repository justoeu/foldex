# Copy to load/k6/env.local. That name is gitignored (*.local).
# A variable already exported by the caller wins over this file.
# Leave a line commented to keep that knob off. Values cannot contain #.

# API under test. When unset, the suite uses http://127.0.0.1:9089.
# K6_BASE_URL=http://127.0.0.1:9089

# Prometheus remote-write receiver. Unset means the terminal summary only.
# K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write

# 1 requires the receiver URL above. 0 leaves the terminal summary only.
# When this is unset, remote write turns on only if the URL is set.
# K6_GRAFANA=1

# Grafana base URL. The dashboard uid for this suite is foldex-k6.
# K6_GRAFANA_URL=http://127.0.0.1:3000

# Container names for the CPU sample. Empty skips that sample.
# FOLDEX_K6_BACKEND=foldex-backend-1
# FOLDEX_K6_POSTGRES=

# Logs, the database URL and the quota snapshot. Default is under /tmp.
# FOLDEX_K6_RUN_DIR=/tmp/foldex-appcheck

# Admission worktree used by scripts/k6-gate-run.sh. Default is ../foldex-admission.
# FOLDEX_ADMISSION_ROOT=

# Metrics scrape. When unset, the suite uses ${K6_BASE_URL}/metrics.
# FOLDEX_K6_METRICS_URL=http://127.0.0.1:9089/metrics
