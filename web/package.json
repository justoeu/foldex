{
  "name": "foldex-web",
  "private": true,
  "version": "2.21.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:nogate": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-placeholder": "3.30.1",
    "@tiptap/extension-text-align": "3.30.1",
    "@tiptap/extension-text-style": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "axios": "^1.19.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^6.0",
    "undici": "7.29.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "postcss": ">=8.5.18",
    "undici": "7.29.0",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "fast-uri": ">=3.1.4"
