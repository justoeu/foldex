# Env / secrets
.env*
!.env.example

# Go
backend/bin/
backend/coverage*.out
backend/cov*.out
backend/foldex
*.test

# Node / Vite
node_modules/
dist/
.vite/
*.local

# Vitest coverage HTML reports — local-only artifact
web/coverage/

# Extension build
extension/dist/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Docker volumes (local data)
.pgdata/
web/certs/

# DB backups produced by scripts/backup.sh
backups/

# Claude Code per-session state (lock files, local user settings)
# `.claude/*`, não `.claude/` — git não reabre um caminho cujo DIRETÓRIO pai foi
# excluído, então a forma com barra faz as negações abaixo não terem efeito
# nenhum, em silêncio.
.claude/*
# As skills do PROJETO ficam versionadas: elas referenciam os invariantes deste
# repo e carregam uma linha de "estado conhecido" que envelhece junto com o
# código — mantê-las fora dele seria garantir que ficassem erradas.
!.claude/skills/
!.claude/skills/**

# Playwright MCP artifacts (snapshots, console logs from in-session debugging)
.playwright-mcp/

# Serena MCP project cache (symbol index, session memories) — regenerated on demand
.serena/

# graphify knowledge-graph output — regenerated on demand via `graphify update .`
# (AST-only, no API cost). Treat as cache: keep current locally, never commit.
graphify-out/

# Local audit packs (ultra-deep etc.) — never commit
docs/audit/

# Operator-supplied CA bundles (broker, etc). The directory is mounted into
# the backend and mailer; its contents are local material, never committed.
certs/*
!certs/.gitkeep
docker-compose.override.yml
